        </Border>
        <Label Content="Métrica de Distancia" HorizontalAlignment="Left" Margin="10,112,0,0" VerticalAlignment="Top" Width="276"/>
        <Label Content="Configuración de variables" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Width="276"/>
