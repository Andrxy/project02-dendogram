        </Border>
        <Label Content="Métrica de Distancia" HorizontalAlignment="Left" Margin="10,112,0,0" VerticalAlignment="Top" Width="276"/>
        <Label Content="Configuración de variables" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Width="276"/>
        <Label x:Name="NombreArchivo" Content="" HorizontalAlignment="Left" Margin="154,67,0,0" VerticalAlignment="Top" Width="203"/>
        <Button x:Name="CargarCSV" Content="Cargar CSV" HorizontalAlignment="Left" Margin="560,10,0,0" VerticalAlignment="Top" Width="93" Height="20" Click="CargarCSV_Click"/>
        <DataGrid x:Name="Tabla1" SelectionChanged="DataGrid_SelectionChanged" Margin="17,235,17,27"/>

